<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BikeCarHub</RootNamespace>
    <UserSecretsId>78c08895-41a1-4dfe-b0a1-8d7edaac7f3d</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;Articles\**;Logs\**;App_Data\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Article Word files; published next to the app, outside wwwroot, so they are read by the site but never served. -->
    <None Include="Articles\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Articles\blogs\2026\Nov\NewFolder\" />
    <Folder Include="wwwroot\images\blogs\2026\Nov\" />
  </ItemGroup>

</Project>
