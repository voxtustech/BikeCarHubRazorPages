@* Heart toggle for saving a model. Needs the script, so it stays hidden without it. *@
@model (BikeCarHub.Domain.Bike Bike, bool Compact)
<button type="button" class="wish-btn@(Model.Compact ? " wish-btn-compact" : "")" data-wish="@Model.Bike.FullSlug" data-wish-name="@Model.Bike.Name"
        aria-pressed="false" aria-label="Save @Model.Bike.Name to your wishlist">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
    @if (!Model.Compact)
    {
        <span class="wish-label" data-wish-label>Save to wishlist</span>
    }
</button>
