@* Layout for the home page: its own header, footer and stylesheet. *@
@inject SiteSettings Site
@inject ICatalogService CatalogService
@inject IImageUrlProvider Images
@inject BikeCarHub.Data.IWriteGate WriteGate
@{
    var meta = ViewData["Meta"] as PageMeta ?? new PageMeta();
    var path = Context.Request.Path.Value ?? "/";
    var canonical = Site.Absolute(meta.CanonicalPath ?? path);
    // Logo 25, cropped to its artwork (25-header.png is 25.png without the empty margins).
    var logo = Images.Resolve("/images/bchlogo/25-header.png");
    // share-25.png is the same logo at 1200x630, the size share cards expect.
    var socialImage = Site.Absolute(meta.Image ?? Images.Resolve("/images/bchlogo/share-25.png"));
    var signedIn = User.Identity?.IsAuthenticated == true;
    var footerBrands = (await CatalogService.GetAsync()).Brands.OrderByDescending(b => b.Bikes.Count).Take(8).ToList();

    (string Label, string Href)[] nav =
    [
        ("New Bikes", "/new-bikes"), ("Electric Bikes", "/electric-bikes"), ("Compare", "/compare"), ("Upcoming", "/upcoming-bikes"), ("News", "/news"),
        ("Blogs", "/blog"), ("EMI Calculator", "/emi-calculator"), ("Ask a Question", "/ask-a-question")
    ];
}
<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@meta.Title</title>
    <meta name="description" content="@meta.Description">
    <meta name="robots" content="@meta.Robots">
    <link rel="canonical" href="@canonical">
    <meta property="og:site_name" content="@Site.Name">
    <meta property="og:type" content="@meta.OgType">
    <meta property="og:title" content="@meta.Title">
    <meta property="og:description" content="@meta.Description">
    <meta property="og:url" content="@canonical">
    <meta property="og:image" content="@socialImage">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@meta.Title">
    <meta name="twitter:description" content="@meta.Description">
    <meta name="twitter:image" content="@socialImage">
    <meta name="theme-color" content="#202020">
    <link rel="icon" type="image/png" sizes="32x32" href="@Images.Resolve("/images/bchlogo/favicon-25-32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Images.Resolve("/images/bchlogo/favicon-25-192.png")">
    <link rel="apple-touch-icon" href="@Images.Resolve("/images/bchlogo/favicon-25-192.png")">
    @if (meta.PreloadImage is not null)
    {
        <link rel="preload" as="image" href="@meta.PreloadImage" fetchpriority="high">
    }
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
    @foreach (var data in meta.JsonLd)
    {
        <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(data))</script>
    }
</head>
<body data-wishlist-user="@BikeCarHub.Pages.Wishlist.IndexModel.SyncUserId(User, WriteGate)">
    <a class="skip" href="#main">Skip to content</a>
    <header class="top" data-top>
        <div class="wrap top-row">
            <a class="logo" href="/" aria-label="@Site.Name home">
                <img src="@logo" alt="" width="112" height="42">
            </a>
            <a class="wish-link wish-link-mobile" href="/wishlist" aria-current="@(path.StartsWith("/wishlist", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
                <span class="wish-text">Wishlist</span>
                <span class="wish-count" data-wish-count hidden></span>
            </a>
            <button class="menu-btn" type="button" data-menu-button aria-controls="top-nav" aria-expanded="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                <span>Menu</span>
            </button>
            <nav id="top-nav" class="top-nav" aria-label="Main">
                <ul>
                    @foreach (var (label, href) in nav)
                    {
                        <li><a href="@href">@label</a></li>
                    }
                </ul>
                <form class="top-search" method="get" action="/search" role="search">
                    <label class="sr-only" for="top-q">Search bikes</label>
                    <input id="top-q" name="q" type="search" maxlength="60" placeholder="Search a bike, e.g. Pulsar">
                    <button type="submit" aria-label="Search">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    </button>
                </form>
                <a class="wish-link wish-link-desktop" href="/wishlist" aria-current="@(path.StartsWith("/wishlist", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
                    <span class="wish-text">Wishlist</span>
                    <span class="wish-count" data-wish-count hidden></span>
                </a>
                @if (signedIn)
                {
                    <form method="post" action="/account/sign-out" class="top-account">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-line" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <div class="top-account"><a class="btn btn-line" href="/account/sign-in">Sign in</a></div>
                }
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="foot">
        <div class="wrap foot-grid">
            <section>
                <img src="@logo" alt="BikeCarHub" width="128" height="48" class="foot-logo">
                <p>BikeCarHub is a one-stop destination for Indian vehicle shoppers, combining pricing tools, informative reviews, comparison features, launch calendars, and news - all maintained by an established tech firm in Dehradun.</p>
                @if (!string.IsNullOrWhiteSpace(Site.Phone))
                {
                    <p><a href="tel:@Site.Phone.Replace(" ", "")">@Site.Phone</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(Site.Email))
                {
                    <p><a href="mailto:@Site.Email">@Site.Email</a></p>
                }
                <ul class="social">
                    <li><a href="https://www.instagram.com/bikecarhub2024/?hl=en" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg></a></li>
                    <li><a href="https://x.com/bikecarhub" target="_blank" rel="noopener noreferrer" aria-label="X"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1H22.58L14.54 10.19 24 23h-7.406l-5.801-7.765L3.891 23H.209L8.81 13.327 0 1h7.594l5.244 7.09L18.901 1Z"/></svg></a></li>
                    <li><a href="https://www.linkedin.com/in/bikecar-hub-a42a81356/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg></a></li>
                </ul>
            </section>
            <section aria-labelledby="foot-explore">
                <h2 id="foot-explore">Explore</h2>
                <ul>
                    <li><a href="/new-bikes">New bikes</a></li>
                    <li><a href="/compare">Compare bikes</a></li>
                    <li><a href="/upcoming-bikes">Upcoming bikes</a></li>
                    <li><a href="/emi-calculator">EMI calculator</a></li>
                    <li><a href="/electric-bikes">Electric bike running cost</a></li>
                    <li><a href="/value-for-money">Value for money picks</a></li>
                    <li><a href="/news">News</a></li>
                    <li><a href="/blog">Blogs</a></li>
                </ul>
            </section>
            <section aria-labelledby="foot-brands">
                <h2 id="foot-brands">Popular brands</h2>
                <ul>
                    @foreach (var brand in footerBrands)
                    {
                        <li><a href="@brand.Url">@brand.Name bikes</a></li>
                    }
                </ul>
            </section>
            <section aria-labelledby="foot-company">
                <h2 id="foot-company">BikeCarHub</h2>
                <ul>
                    <li><a href="/about">About</a></li>
                    <li><a href="/ask-a-question">Contact</a></li>
                    <li><a href="/privacy">Privacy policy</a></li>
                    <li><a href="/terms">Terms and conditions</a></li>
                    <li><a href="/disclaimer">Disclaimer</a></li>
                </ul>
            </section>
        </div>
        <div class="wrap foot-base">
            <p>© <a href="https://www.voxtus.com" target="_blank" rel="noopener noreferrer">Voxtus Technologies Pvt. Ltd.</a> All rights reserved.</p>
            <p>Prices are ex-showroom and indicative. Confirm the final price with your dealer.</p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/home.js" asp-append-version="true" defer></script>
</body>
</html>
