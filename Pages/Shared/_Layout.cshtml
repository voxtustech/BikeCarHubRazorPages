@inject SiteSettings Site
@inject ICatalogService CatalogService
@inject IImageUrlProvider Images
@inject BikeCarHub.Data.IWriteGate WriteGate
@{
    var meta = ViewData["Meta"] as PageMeta ?? new PageMeta();
    var path = Context.Request.Path.Value ?? "/";
    var isStatusPage = path.StartsWith("/status/", StringComparison.OrdinalIgnoreCase);
    var canonical = Site.Absolute(meta.CanonicalPath ?? path);
    // Logo 25, cropped to its artwork (25-header.png is 25.png without the empty margins); share-25.png is the same logo at 1200x630 for share cards.
    var logo = Images.Resolve("/images/bchlogo/25-header.png");
    var socialImage = Site.Absolute(meta.Image ?? Images.Resolve("/images/bchlogo/share-25.png"));
    var signedIn = User.Identity?.IsAuthenticated == true;

    IReadOnlyList<Brand> footerBrands = [];
    try
    {
        footerBrands = (await CatalogService.GetAsync()).Brands.OrderByDescending(b => b.Bikes.Count).Take(12).ToList();
    }
    catch (Exception)
    {
        // The error page must still render when the database is unreachable.
    }

    (string Label, string Href)[] nav =
    [
        // Electric bikes are linked from /new-bikes and the footer, and the current section's link is hidden, so the menu fits on one row with the logo.
        ("Home", "/"), ("New Bikes", "/new-bikes"), ("Upcoming", "/upcoming-bikes"), ("News", "/news"), ("Blogs", "/blog"),
        ("Compare", "/compare"), ("EMI Calculator", "/emi-calculator"), ("Ask a Question", "/ask-a-question")
    ];
    // Whole path segments only, so /newsletter does not count as /news.
    bool IsCurrent(string href) => href == "/" ? path == "/"
        : path.Equals(href, StringComparison.OrdinalIgnoreCase) || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@meta.Title</title>
    <meta name="description" content="@meta.Description">
    <meta name="robots" content="@meta.Robots">
    @if (!isStatusPage)
    {
        <link rel="canonical" href="@canonical">
        <meta property="og:url" content="@canonical">
    }
    <meta property="og:site_name" content="@Site.Name">
    <meta property="og:type" content="@meta.OgType">
    <meta property="og:title" content="@meta.Title">
    <meta property="og:description" content="@meta.Description">
    <meta property="og:image" content="@socialImage">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@meta.Title">
    <meta name="twitter:description" content="@meta.Description">
    <meta name="twitter:image" content="@socialImage">
    <meta name="theme-color" content="#202020">
    <link rel="icon" type="image/png" sizes="32x32" href="@Images.Resolve("/images/bchlogo/favicon-25-32.png")">
    <link rel="icon" type="image/png" sizes="192x192" href="@Images.Resolve("/images/bchlogo/favicon-25-192.png")">
    <link rel="apple-touch-icon" href="@Images.Resolve("/images/bchlogo/favicon-25-192.png")">
    @if (meta.PreloadImage is not null)
    {
        <link rel="preload" as="image" href="@meta.PreloadImage" fetchpriority="high">
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @if (meta.Breadcrumbs.Count > 1)
    {
        <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(JsonLd.Breadcrumbs(Site, meta.Breadcrumbs, path)))</script>
    }
    @foreach (var data in meta.JsonLd)
    {
        <script type="application/ld+json">@Html.Raw(JsonLd.Serialize(data))</script>
    }
</head>
<body data-wishlist-user="@BikeCarHub.Pages.Wishlist.IndexModel.SyncUserId(User, WriteGate)">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="container header-row">
            <a class="brand-mark" href="/" aria-label="@Site.Name home">
                <img src="@logo" alt="" width="107" height="40">
            </a>
            <a class="wish-link wish-link-mobile" href="/wishlist" aria-current="@(path.StartsWith("/wishlist", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
                <span class="wish-text">Wishlist</span>
                <span class="wish-count" data-wish-count hidden></span>
            </a>
            <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false">Menu</button>
            <nav id="site-nav" class="site-nav" aria-label="Main">
                <ul>
                    @foreach (var (label, href) in nav.Where(n => !IsCurrent(n.Href)))
                    {
                        <li><a href="@href">@label</a></li>
                    }
                </ul>
                <a class="wish-link wish-link-desktop" href="/wishlist" aria-current="@(path.StartsWith("/wishlist", StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 6.9 4.5c2.1 0 3.6 1.2 5.1 3 1.5-1.8 3-3 5.1-3 3.5 0 5.5 3.5 4.2 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
                    <span class="wish-text">Wishlist</span>
                    <span class="wish-count" data-wish-count hidden></span>
                </a>
                @if (signedIn)
                {
                    <form class="account" method="post" action="/account/sign-out">
                        @Html.AntiForgeryToken()
                        <span class="account-name">@User.Identity!.Name</span>
                        <button class="btn btn-ghost" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <div class="account"><a class="btn btn-accent" href="/account/sign-in">Sign in</a></div>
                }
            </nav>
        </div>
    </header>

    @if (meta.Breadcrumbs.Count > 1)
    {
        <nav class="breadcrumbs container" aria-label="Breadcrumb">
            <ol>
                @for (var i = 0; i < meta.Breadcrumbs.Count; i++)
                {
                    var crumb = meta.Breadcrumbs[i];
                    if (i == meta.Breadcrumbs.Count - 1 || crumb.Path is null)
                    {
                        <li aria-current="page">@crumb.Name</li>
                    }
                    else
                    {
                        <li><a href="@crumb.Path">@crumb.Name</a></li>
                    }
                }
            </ol>
        </nav>
    }

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <section aria-labelledby="footer-links">
                <h2 id="footer-links">BikeCarHub</h2>
                <ul>
                    <li><a href="/ask-a-question">Contact BikeCarHub</a></li>
                    <li><a href="/about">About BikeCarHub</a></li>
                    <li><a href="/upcoming-bikes">Upcoming bikes</a></li>
                    <li><a href="/electric-bikes">Electric bike running cost</a></li>
                    <li><a href="/compare">Compare</a></li>
                    <li><a href="/privacy">Privacy policy</a></li>
                    <li><a href="/terms">Terms and conditions</a></li>
                    <li><a href="/disclaimer">Disclaimer</a></li>
                </ul>
            </section>
            @if (footerBrands.Count > 0)
            {
                <section aria-labelledby="footer-brands">
                    <h2 id="footer-brands">Popular brands</h2>
                    <ul class="two-col">
                        @foreach (var brand in footerBrands)
                        {
                            <li><a href="@brand.Url">@brand.Name bikes</a></li>
                        }
                    </ul>
                </section>
            }
            <section aria-labelledby="footer-newsletter">
                <h2 id="footer-newsletter">Newsletter</h2>
                <p>Keep up with our always evolving products, features and technology. Enter your email and subscribe to our newsletter.</p>
                <form class="inline-form" method="get" action="/newsletter">
                    <label class="sr-only" for="footer-email">Email address</label>
                    <input id="footer-email" name="email" type="email" required maxlength="150" autocomplete="email" placeholder="Enter your email address">
                    <button class="btn btn-accent" type="submit">Subscribe</button>
                </form>
            </section>
            <section aria-labelledby="footer-about">
                <h2 id="footer-about">About BikeCarHub</h2>
                <p>BikeCarHub is a one-stop destination for Indian vehicle shoppers, combining pricing tools, informative reviews, comparison features, launch calendars, and news - all maintained by an established tech firm in Dehradun.</p>
                @if (!string.IsNullOrWhiteSpace(Site.Phone))
                {
                    <p>Phone: <a href="tel:@Site.Phone.Replace(" ", "")">@Site.Phone</a></p>
                }
                @if (!string.IsNullOrWhiteSpace(Site.Email))
                {
                    <p>Email: <a href="mailto:@Site.Email">@Site.Email</a></p>
                }
            </section>
        </div>
        <p class="container footer-note">Prices are ex-showroom and indicative. Confirm the final price with your dealer.</p>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
