    {
        Title = "Terms and Conditions | BikeCarHub",
        Description = "The terms that apply when you use BikeCarHub.",
        CanonicalPath = "/terms"
    }.Crumbs(("Terms and conditions", "/terms"));
}

<div class="container section prose">
    <h1>Terms and conditions</h1>
    <p class="notice notice-demo">Sample text. Replace with your reviewed terms before launch.</p>
    <h2>Using this site</h2>
    <p>BikeCarHub provides vehicle information for general guidance. It does not sell vehicles and is not a dealer.</p>
    <h2>Accuracy</h2>
    <p>We work to keep information accurate, but prices and specifications can change. See the <a href="/disclaimer">disclaimer</a>.</p>
    <h2>Accounts</h2>
    <p>You are responsible for keeping your password confidential and for activity on your account.</p>
</div>
