@page "/new-bikes/{brand}/{model}/{variant?}"
@model DetailModel
@inject IImageUrlProvider Images
@{
    var bike = Model.Bike;
    var heading = Model.IsVariantPage ? Model.Selected!.Name : bike.Name;
    var alt = Model.IsVariantPage ? $"{bike.Brand.Name} {bike.ShortName} {Model.Selected!.ShortName}" : bike.Name;
    var first = Model.FirstColour;
    var modelImage = Images.Resolve(bike.ImagePath);
}

<article class="container section">
    <div class="detail-head">
        <div>
            <div class="detail-media" data-colour-stage>
                @Html.Img(Model.HeroImagePath, first is null ? alt : $"{alt} in {first.Name}", 640, 427, eager: true)
            </div>
            @if (Model.Colours.Count > 0)
            {
                <div class="colours" data-colour-picker data-alt="@alt">
                    <p class="colour-current" aria-live="polite">
                        <span class="colour-label">Colour:</span> <strong data-colour-name>@(first?.Name ?? Model.Colours[0].Name)</strong>
                        <span class="colour-note" data-colour-note hidden="@(first is not null)">Photo in this colour not available yet</span>
                    </p>
                    <ul class="colour-swatches" aria-label="Choose a colour">
                        @foreach (var colour in Model.Colours)
                        {
                            var pressed = first is null ? colour == Model.Colours[0] : colour == first;
                            <li>
                                <button type="button" class="colour-swatch" title="@colour.Name" aria-label="@colour.Name" aria-pressed="@(pressed ? "true" : "false")"
                                        data-colour="@colour.Name" data-src="@(colour.ImagePath is null ? modelImage : Images.Resolve(colour.ImagePath))" data-photo="@(colour.ImagePath is null ? "0" : "1")">
                                    <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false">
                                        @if (colour.IsDualTone)
                                        {
                                            <path d="M1 12a11 11 0 0 1 22 0z" fill="@colour.TopHex" />
                                            <path d="M1 12a11 11 0 0 0 22 0z" fill="@colour.BottomHex" />
                                        }
                                        else
                                        {
                                            <circle cx="12" cy="12" r="11" fill="@(colour.Hex ?? colour.TopHex ?? "#C9CED6")" />
                                        }
                                        <circle class="swatch-ring" cx="12" cy="12" r="11" />
                                    </svg>
                                </button>
                            </li>
                        }
                    </ul>
                    <p class="colour-list">Available in @Model.Colours.Count @(Model.Colours.Count == 1 ? "colour" : "colours"): @string.Join(", ", Model.Colours.Select(c => c.Name)).</p>
                </div>
            }
        </div>
        <div>
            <h1>@heading</h1>
            <p class="price price-large">@Formatting.PriceRange(bike.MinPrice, bike.MaxPrice)</p>
            @if (bike.MinPrice is not null)
            {
                <p class="meta">Ex-showroom price for the @bike.Name range. Indicative only; confirm with your dealer.</p>
            }
            <dl class="key-facts">
                <div><dt>Brand</dt><dd><a href="@bike.Brand.Url">@bike.Brand.Name</a></dd></div>
                <div><dt>Type</dt><dd>@(bike.Type ?? Formatting.NotAvailable)</dd></div>
                <div><dt>Fuel</dt><dd>@(bike.IsEv ? "Electric" : "Petrol")</dd></div>
                @if (!bike.IsEv)
                {
                    <div><dt>Engine</dt><dd>@(bike.DisplacementCc is { } cc ? $"{Formatting.Number(cc)} cc" : Formatting.NotAvailable)</dd></div>
                    <div><dt>Mileage</dt><dd>@(bike.MileageKmpl is { } kmpl ? $"{Formatting.Number(kmpl)} km/l" : Formatting.NotAvailable)</dd></div>
                }
                <div><dt>Launched</dt><dd>@(bike.LaunchText ?? Formatting.NotAvailable)</dd></div>
            </dl>
            <div class="detail-actions">
                <partial name="_WishButton" model="(bike, false)" />
                <a class="btn btn-ghost" href="/compare?a=@bike.FullSlug">Compare this bike</a>
            </div>
            @if (Model.RunningCostUrl is { } runningCost)
            {
                <p><a class="btn btn-accent" href="@runningCost">Running cost and charging</a></p>
            }
        </div>
    </div>

    @if (bike.Description is not null)
    {
        <section aria-labelledby="about-heading">
            <h2 id="about-heading">About the @bike.Name</h2>
            <p>@bike.Description</p>
        </section>
    }

    @if (bike.Variants.Count > 0)
    {
        <section aria-labelledby="variants-heading">
            <h2 id="variants-heading">@bike.Name variants</h2>
            <ul class="chip-row">
                @foreach (var variant in bike.Variants)
                {
                    <li><a class="chip" href="@variant.Url" aria-current="@(Model.IsVariantPage && variant == Model.Selected ? "page" : null)">@variant.ShortName</a></li>
                }
            </ul>
        </section>
    }

    @if (Model.Sections.Count > 0)
    {
        <section aria-labelledby="specs-heading">
            <h2 id="specs-heading">@Model.Selected!.Name specifications</h2>
            <div class="spec-grid">
                @foreach (var specs in Model.Sections)
                {
                    <div class="table-wrap">
                        <table class="spec">
                            <caption>@specs.Title</caption>
                            <tbody>
                                @foreach (var item in specs.Items)
                                {
                                    <tr><th scope="row">@item.Label</th><td>@item.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <p class="notice">Specifications for this model are not available yet.</p>
    }

    @if (Model.Similar.Count > 0)
    {
        <section aria-labelledby="similar-heading">
            <h2 id="similar-heading">Similar bikes</h2>
            <div class="grid grid-bikes">
                @foreach (var other in Model.Similar)
                {
                    <partial name="_BikeCard" model="other" />
                }
            </div>
        </section>
    }

    <p><a href="@bike.Brand.Url">All @bike.Brand.Name bikes</a></p>
</article>
