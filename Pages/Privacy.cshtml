@page "/privacy"
@{
    ViewData["Meta"] = new PageMeta
    {
        Title = "Privacy Policy | BikeCarHub",
        Description = "What information BikeCarHub collects through its forms and accounts.",
        CanonicalPath = "/privacy"
    }.Crumbs(("Privacy policy", "/privacy"));
}

<div class="container section prose">
    <h1>Privacy policy</h1>
    <p class="notice notice-demo">Sample text. Replace with your reviewed privacy policy before launch.</p>
    <h2>Information you give us</h2>
    <p>When you create an account, subscribe to the newsletter or ask a question, we collect the details you enter in that form, such as your name, email address and message.</p>
    <h2>Cookies</h2>
    <p>The site uses cookies needed for it to work: one to keep you signed in and one to protect forms against forgery.</p>
    <h2>Contact</h2>
    <p>For any privacy request, <a href="/ask-a-question">contact us</a>.</p>
</div>
