@page "/account/forgot-password"
@model ForgotPasswordModel

<div class="container section narrow">
    <h1>Forgot password</h1>
    @if (Model.Notice is not null)
    {
        <p class="notice @(Model.IsDemo ? "notice-demo" : "notice-ok")" role="status">@Model.Notice</p>
    }
    <p class="lead">Enter your account email and we will send you a link to choose a new password.</p>
    <form class="panel" method="post" novalidate>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="email" required>
        <span asp-validation-for="Email" class="field-error"></span>
        <button class="btn btn-accent" type="submit">Send reset link</button>
    </form>
    <p><a href="/account/sign-in">Back to sign in</a></p>
</div>
