@page "/ask-a-question"
@model AskModel

<div class="container section narrow">
    <h1>Ask a question</h1>
    <p class="lead">Tell us what you would like to know and we will get back to you by email.</p>

    @if (Model.Outcome is not null)
    {
        <p class="notice @(Model.IsDemo ? "notice-demo" : "notice-ok")" role="status">@Model.Outcome</p>
    }

    <form class="panel" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>
        <label asp-for="Input.Name">Name</label>
        <input asp-for="Input.Name" autocomplete="name" maxlength="60" required>
        <span asp-validation-for="Input.Name" class="field-error"></span>

        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" autocomplete="email" maxlength="150" required>
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.Question">Question</label>
        <textarea asp-for="Input.Question" rows="6" maxlength="2000" required></textarea>
        <span asp-validation-for="Input.Question" class="field-error"></span>

        <div class="hp" aria-hidden="true">
            <label asp-for="Input.Website">Leave this field empty</label>
            <input asp-for="Input.Website" tabindex="-1" autocomplete="off">
        </div>

        <button class="btn btn-accent" type="submit">Submit</button>
    </form>
</div>
